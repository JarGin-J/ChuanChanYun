<?xml version="1.0" encoding="utf-8"?>
<!--
  平板（sw600dp 及以上）：同一份 ConstraintLayout 布局，仅用资源限定符把表单收成居中窄栏。
  不另写一套布局文件，避免两套 XML 逻辑分叉；宽度由左右 margin 自动约束，不会拉伸错位。
-->
<resources>
    <dimen name="reg_side_margin">160dp</dimen>
    <dimen name="reg_top_margin">36dp</dimen>
    <dimen name="reg_section_gap">16dp</dimen>
    <dimen name="reg_field_height">50dp</dimen>
    <dimen name="reg_button_height">54dp</dimen>
    <dimen name="reg_title_size">26sp</dimen>
    <dimen name="reg_subtitle_size">14sp</dimen>
    <dimen name="reg_label_size">15sp</dimen>
    <dimen name="reg_body_size">16sp</dimen>
</resources>
