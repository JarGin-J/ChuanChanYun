<?xml version="1.0" encoding="utf-8"?>
<!--
  川产云 · 迭代 1 清单文件
  本迭代只做「环境搭建 + 注册页」，因此：
   · 不申请任何权限（网络、存储等均为后续迭代内容）；
   · 只声明 2 个 Activity：注册页（启动页）与 HelloWorld 环境验证页。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scyun">

        <!-- Sprint 1 主界面：注册页。首次迭代没有登录页，注册页即 Launcher -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          功能要求 1 的验证载体：HelloWorld 模拟器跑通，用 adb 单独拉起，不占用桌面入口。
          本页不承载任何数据、不申请权限，仅为方便课堂用 adb 演示，故允许外部（shell）启动；
          注册的 2 个 Activity 均无 intent-filter 暴露给第三方 App 的敏感入口。
        -->
        <activity
            android:name=".ui.HelloWorldActivity"
            android:exported="true"
            android:label="@string/hello_title" />
    </application>

</manifest>
